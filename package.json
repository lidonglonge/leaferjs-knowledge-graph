{
  "name": "leaferjs-knowledge-graph",
  "version": "0.1.0",
  "description": "A knowledge graph visualization plugin for LeaferJS, similar to AntV G6",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "keywords": [
    "leaferjs",
    "knowledge-graph",
    "graph-visualization",
    "graph",
    "visualization",
    "canvas",
    "typescript"
  ],
  "author": "lidonglonge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidonglonge/leaferjs-knowledge-graph.git"
  },
  "bugs": {
    "url": "https://github.com/lidonglonge/leaferjs-knowledge-graph/issues"
  },
  "homepage": "https://github.com/lidonglonge/leaferjs-knowledge-graph#readme",
  "peerDependencies": {
    "leafer-ui": "^1.0.2"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "leafer-ui": "^1.0.2"
  }
}
